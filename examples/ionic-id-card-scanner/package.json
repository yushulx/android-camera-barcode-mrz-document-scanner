{
  "name": "ionic-id-card-scanner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ionic Vue ID card / MRZ scanner built on the Dynamsoft MRZ Scanner native SDKs (Android + iOS)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@ionic/vue": "^9.0.2",
    "@ionic/vue-router": "^9.0.2",
    "ionicons": "^8.1.0",
    "vue": "^3.5.42",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
