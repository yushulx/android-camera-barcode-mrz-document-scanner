<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- App Icon -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_app_icon"
                android:contentDescription="@string/app_name" />

            <!-- App Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/document_scanner"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Illustration -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:src="@drawable/ic_scanner_illustration"
            android:contentDescription="@string/document_scanner" />

        <!-- Section Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="@string/choose_scanner"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Dynamsoft Scanner Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_dynamsoft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background_ripple"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iv_dynamsoft_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_dynamsoft"
                android:contentDescription="@string/dynamsoft_scanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_dynamsoft_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:text="@string/dynamsoft_scanner"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/iv_dynamsoft_arrow"
                app:layout_constraintStart_toEndOf="@+id/iv_dynamsoft_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_dynamsoft_icon" />

            <TextView
                android:id="@+id/tv_dynamsoft_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:text="@string/dynamsoft_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="3"
                android:ellipsize="end"
                app:layout_constraintEnd_toStartOf="@+id/iv_dynamsoft_arrow"
                app:layout_constraintStart_toEndOf="@+id/iv_dynamsoft_icon"
                app:layout_constraintTop_toBottomOf="@+id/tv_dynamsoft_title" />

            <ImageView
                android:id="@+id/iv_dynamsoft_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/gradient_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Professional"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/tv_dynamsoft_desc"
                app:layout_constraintTop_toBottomOf="@+id/tv_dynamsoft_desc" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Google ML Kit Scanner Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_google_mlkit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background_ripple"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iv_google_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_google"
                android:contentDescription="@string/google_mlkit_scanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_google_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:text="@string/google_mlkit_scanner"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/iv_google_arrow"
                app:layout_constraintStart_toEndOf="@+id/iv_google_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_google_icon" />

            <TextView
                android:id="@+id/tv_google_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:text="@string/google_mlkit_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="3"
                android:ellipsize="end"
                app:layout_constraintEnd_toStartOf="@+id/iv_google_arrow"
                app:layout_constraintStart_toEndOf="@+id/iv_google_icon"
                app:layout_constraintTop_toBottomOf="@+id/tv_google_title" />

            <ImageView
                android:id="@+id/iv_google_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/success_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Free"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/tv_google_desc"
                app:layout_constraintTop_toBottomOf="@+id/tv_google_desc" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Compare document scanning solutions"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>