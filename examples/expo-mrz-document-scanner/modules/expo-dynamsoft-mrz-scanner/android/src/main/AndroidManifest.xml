<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera data source -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Image file data source -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application>
        <!-- Invisible bridge that hosts startActivityForResult on behalf of the
             Expo module (Expo modules cannot register RN activity listeners). -->
        <activity
            android:name=".BridgeResultActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />

        <activity
            android:name=".IdScanActivity"
            android:label="MRZ Document Scanner"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:screenOrientation="portrait"
            android:exported="false" />
    </application>
</manifest>
